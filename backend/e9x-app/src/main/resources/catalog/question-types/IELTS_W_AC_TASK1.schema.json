{
  "code": "IELTS_W_AC_TASK1",
  "content": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "IELTS Writing Academic Task 1",
    "type": "object",
    "properties": {
      "prompt": {
        "title": "Task",
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      },
      "minWords": {
        "title": "Minimum words",
        "type": "integer",
        "minimum": 150,
        "maximum": 1000
      },
      "imageMediaId": {
        "title": "Image media id",
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "required": [
      "prompt",
      "minWords",
      "imageMediaId"
    ],
    "additionalProperties": false
  },
  "answerKey": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Writing: no answer key, only an optional model answer",
    "type": "object",
    "properties": {
      "sampleAnswer": {
        "title": "Model answer",
        "type": "string",
        "minLength": 1,
        "maxLength": 10000,
        "pattern": "\\S"
      },
      "notes": {
        "title": "Notes for graders",
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
