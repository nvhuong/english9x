{
  "code": "IELTS_W_TASK2",
  "content": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "IELTS Writing Task 2",
    "type": "object",
    "properties": {
      "prompt": {
        "title": "Task",
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      },
      "minWords": {
        "title": "Minimum words",
        "type": "integer",
        "minimum": 250,
        "maximum": 1000
      }
    },
    "required": [
      "prompt",
      "minWords"
    ],
    "additionalProperties": false
  },
  "answerKey": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Writing: no answer key, only an optional model answer",
    "type": "object",
    "properties": {
      "sampleAnswer": {
        "title": "Model answer",
        "type": "string",
        "minLength": 1,
        "maxLength": 10000,
        "pattern": "\\S"
      },
      "notes": {
        "title": "Notes for graders",
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
