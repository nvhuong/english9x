{
  "code": "IELTS_L_MULTIPLE_CHOICE",
  "content": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "IELTS Listening multiple choice",
    "type": "object",
    "properties": {
      "stem": {
        "title": "Question",
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "options": {
        "title": "Options",
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "title": "Option key",
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,4}$"
            },
            "text": {
              "title": "Option text",
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            }
          },
          "required": [
            "key",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "selectCount": {
        "title": "How many answers to choose",
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "audioMediaId": {
        "title": "Audio media id",
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "transcript": {
        "title": "Transcript",
        "type": "string",
        "minLength": 1,
        "maxLength": 20000,
        "pattern": "\\S"
      },
      "imageMediaId": {
        "title": "Image media id",
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "required": [
      "stem",
      "options",
      "selectCount"
    ],
    "additionalProperties": false
  },
  "answerKey": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Correct options",
    "type": "object",
    "properties": {
      "slots": {
        "title": "Accepted answers",
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,4}$"
          }
        }
      }
    },
    "required": [
      "slots"
    ],
    "additionalProperties": false
  }
}
