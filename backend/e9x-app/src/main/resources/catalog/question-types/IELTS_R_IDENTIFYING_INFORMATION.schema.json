{
  "code": "IELTS_R_IDENTIFYING_INFORMATION",
  "content": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "IELTS Reading identifying information (True / False / Not Given)",
    "type": "object",
    "properties": {
      "statement": {
        "title": "Statement",
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      }
    },
    "required": [
      "statement"
    ],
    "additionalProperties": false
  },
  "answerKey": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Correct answer",
    "type": "object",
    "properties": {
      "slots": {
        "title": "Accepted answers",
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "TRUE",
              "FALSE",
              "NOT GIVEN"
            ]
          }
        }
      }
    },
    "required": [
      "slots"
    ],
    "additionalProperties": false
  }
}
