{
  "code": "IELTS_L_SHORT_ANSWER",
  "content": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "IELTS Listening short answer",
    "type": "object",
    "properties": {
      "stem": {
        "title": "Question",
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "audioMediaId": {
        "title": "Audio media id",
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "imageMediaId": {
        "title": "Image media id",
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "required": [
      "stem"
    ],
    "additionalProperties": false
  },
  "answerKey": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Accepted answers",
    "type": "object",
    "properties": {
      "slots": {
        "title": "Accepted variants per blank",
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          }
        }
      },
      "maxWords": {
        "title": "Word limit per answer (0 = none)",
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      },
      "transcript": {
        "title": "Transcript (review material, shown after submitting)",
        "type": "string",
        "minLength": 1,
        "maxLength": 20000,
        "pattern": "\\S"
      }
    },
    "required": [
      "slots"
    ],
    "additionalProperties": false
  }
}
