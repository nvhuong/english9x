{
  "code": "TOEIC_P6_TEXT_COMPLETION",
  "content": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TOEIC Part 6 Text Completion",
    "type": "object",
    "properties": {
      "gapNumber": {
        "title": "Blank number",
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "stem": {
        "title": "Context (the sentence around the blank)",
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      },
      "options": {
        "title": "Options (words, phrases or sentences to insert)",
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "title": "Option key",
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,4}$"
            },
            "text": {
              "title": "Option text",
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            }
          },
          "required": [
            "key",
            "text"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "gapNumber",
      "options"
    ],
    "additionalProperties": false
  },
  "answerKey": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Correct option",
    "type": "object",
    "properties": {
      "slots": {
        "title": "Accepted answers",
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,4}$"
          }
        }
      }
    },
    "required": [
      "slots"
    ],
    "additionalProperties": false
  }
}
