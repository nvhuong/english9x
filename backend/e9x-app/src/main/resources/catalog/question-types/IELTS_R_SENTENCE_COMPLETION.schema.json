{
  "code": "IELTS_R_SENTENCE_COMPLETION",
  "content": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "IELTS Reading sentence completion",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title of the form, notes, table or summary",
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "\\S"
      },
      "text": {
        "title": "Text with the blanks written as [[1]], [[2]], ...",
        "type": "string",
        "minLength": 1,
        "maxLength": 6000,
        "pattern": "\\S"
      },
      "imageMediaId": {
        "title": "Image media id",
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "answerKey": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Accepted answers per blank",
    "type": "object",
    "properties": {
      "slots": {
        "title": "Accepted variants per blank",
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          }
        }
      },
      "maxWords": {
        "title": "Word limit per answer (0 = none)",
        "type": "integer",
        "minimum": 0,
        "maximum": 10
      }
    },
    "required": [
      "slots"
    ],
    "additionalProperties": false
  }
}
