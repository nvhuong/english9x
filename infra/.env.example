# Copy to infra/.env (git-ignored) and fill in. Compose reads it with:  docker compose --env-file infra/.env -f infra/docker-compose.yml ...
#   cp infra/.env.example infra/.env
#   sed -i.bak "s/^E9X_JWT_SECRET=.*/E9X_JWT_SECRET=$(openssl rand -hex 32)/" infra/.env && rm infra/.env.bak
#
# ---- Needed even on a laptop: the app and Compose refuse to start without them ------------------------------------------------------------
# Signing key of the access tokens, at least 32 bytes.  openssl rand -hex 32
E9X_JWT_SECRET=
# SMTP server for account mail. mail.invalid lets the stack start on a laptop and delivers nothing (the app logs each failed send):
# to read the mail locally use the dev overlay (README, Mailpit). A public E9X_DOMAIN refuses this placeholder.
E9X_SMTP_HOST=mail.invalid
E9X_SMTP_PORT=587
E9X_SMTP_USER=
E9X_SMTP_PASSWORD=
E9X_MAIL_FROM=English9x <no-reply@english9x.vn>
# Real SMTP usually also needs these two, added to the app's environment:
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true  SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ---- Public host name. localhost gets a Caddy-internal certificate; anything else gets Let's Encrypt, and then ------------------------------
# ---- the stack refuses to start while a password below is still a development default (infra/preflight.sh) ---------------------------------
E9X_DOMAIN=localhost

# Uncomment and set each of these for anything but a laptop. Generate each one with:  openssl rand -hex 24
# POSTGRES_PASSWORD=          bootstrap superuser, used by backups only
# E9X_FLYWAY_PASSWORD=        role e9x_owner: migrations, restore
# E9X_DB_PASSWORD=            role e9x_app_login: the application
# E9X_WORKER_DB_PASSWORD=     role e9x_worker_login: background jobs
# MINIO_ROOT_PASSWORD=        object store (root: only MinIO itself and the one-shot minio-init hold it)
# E9X_MINIO_SECRET_KEY=       the application's own key to the media bucket (access key E9X_MINIO_ACCESS_KEY, default e9x_media_app)
# These take effect when the database volume is first created; on an existing volume rotate them with 01-roles.sh (README).

# ---- Media (F12) -----------------------------------------------------------------------------------------------------------------------
# Uploaded audio, images and video live in a private MinIO bucket and are opened through links the app signs for https://$E9X_DOMAIN. Nothing to set on a
# laptop. The bucket name is also what Caddy forwards (/<bucket>/<id>?X-Amz-...): change it here only, before the first start.
# E9X_MINIO_BUCKET=e9x-media
# E9X_MINIO_ACCESS_KEY=e9x_media_app

# ---- Optional ---------------------------------------------------------------------------------------------------------------------------
# E9X_GEMINI_API_KEY=         AI grading
# E9X_GOOGLE_CLIENT_ID=       Google sign-in (off unless both are set)
# E9X_GOOGLE_CLIENT_SECRET=
# E9X_TELEGRAM_BOT_TOKEN=     Telegram notifications (README, Notifications)
# E9X_TELEGRAM_BOT_USERNAME=
# E9X_TELEGRAM_WEBHOOK_SECRET=    openssl rand -hex 32
