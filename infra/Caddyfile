# HTTPS front door. Local/dev: E9X_DOMAIN=localhost gives a Caddy-internal certificate.
# Production: set E9X_DOMAIN to the public hostname (Let's Encrypt is automatic).
{$E9X_DOMAIN:localhost} {
	encode zstd gzip
	# HSTS everywhere except the local development certificate (it would stick to https://localhost in dev browsers).
	@public not host localhost
	header @public Strict-Transport-Security "max-age=31536000"
	# Caddy puts the real client address in X-Forwarded-For (replacing any value the client sent); the app believes it
	# only from the networks in E9X_AUTH_TRUSTED_PROXIES.
	reverse_proxy app:8080
}
