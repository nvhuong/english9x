# HTTPS front door. Local/dev: E9X_DOMAIN=localhost gives a Caddy-internal certificate.
# Production: set E9X_DOMAIN to the public hostname (Let's Encrypt is automatic).
{$E9X_DOMAIN:localhost} {
	encode zstd gzip
	# HSTS everywhere except the local development certificate (it would stick to https://localhost in dev browsers).
	@public not host localhost
	header @public Strict-Transport-Security "max-age=31536000"
	# Caddy puts the real client address in X-Forwarded-For (replacing any value the client sent); the app believes it
	# only from the networks in E9X_AUTH_TRUSTED_PROXIES.
	# Request body limits. The limit applies to the bytes actually received, so a lying Content-Length does not help.
	#  * 1MB: the Telegram webhook, a few KB per update.
	#  * 600MB: only the two upload routes. Excel import (P2.7) takes a workbook and a media ZIP of up to 500MB (e9x.content.import.max-media-size, spec 7.4)
	#    plus multipart overhead, so keep this above that key; the media upload (P2.2) stays below it. The app rejects an over-size file with a clear error.
	#  * 10MB: everything else under /api, so an unauthenticated JSON route cannot be made to buffer 600MB.
	# A new upload route goes in @upload; anything else gets 413 above 10MB.
	@webhook path /api/telegram/webhook
	request_body @webhook {
		max_size 1MB
	}
	@upload path /api/cms/media /api/cms/import
	request_body @upload {
		max_size 600MB
	}
	@api {
		path /api/*
		not path /api/telegram/webhook /api/cms/media /api/cms/import
	}
	request_body @api {
		max_size 10MB
	}

	# Media (P2.2). The app signs links for THIS host (https://{$E9X_DOMAIN}/<bucket>/<id>?X-Amz-...) and the browser fetches them here, same origin, so
	# the CSP needs no extra source and MinIO needs no published port. What makes this not an open proxy:
	#  * only GET (a presigned link is valid for the method it was signed for, and players use GET with Range), only the one bucket, only a path of exactly one object key (the app's keys are row ids: hex and dashes), and only with a
	#    SigV4 signature in the query. Anything else under that bucket path, another bucket, the MinIO admin API (/minio/...) and the console are never
	#    forwarded: they fall through to the app and are a 404 there;
	#  * the bucket is private and the signature binds method, path, query, expiry and Host, so MinIO (not Caddy) refuses an unsigned, altered or expired
	#    request; Caddy forwards the signature, it does not know the secret;
	#  * no header_up Host: Caddy's reverse_proxy keeps the Host the client sent, which is what was signed. Rewriting it to minio:9000 (header_up Host
	#    {upstream_hostport}) breaks every signature (measured in scripts/test-infra.sh);
	#  * the answer is marked as a download-only sandbox (CSP default-src 'none'; sandbox) and nosniff, whatever the object holds; the server banner is dropped.
	@media {
		method GET
		path_regexp media ^/{$E9X_MINIO_BUCKET:e9x-media}/[0-9a-f-]+$
		query X-Amz-Signature=*
	}
	handle @media {
		reverse_proxy minio:9000 {
			header_down Content-Security-Policy "default-src 'none'; sandbox"
			header_down X-Content-Type-Options nosniff
			header_down -Server
		}
	}
	handle {
		reverse_proxy app:8080
	}
}

# Only the container's own healthcheck reaches this (bound to loopback, not published): "/" through Caddy to the app.
http://127.0.0.1:2080 {
	bind 127.0.0.1
	@notRoot not path /
	respond @notRoot 404
	reverse_proxy app:8080
}
