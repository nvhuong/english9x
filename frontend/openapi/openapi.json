{
  "components" : {
    "schemas" : {
      "AuthConfig" : {
        "properties" : {
          "googleEnabled" : {
            "description" : "false when Google sign-in is not configured: hide the button",
            "type" : "boolean"
          }
        },
        "required" : [ "googleEnabled" ],
        "type" : "object"
      },
      "EmailRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "Me" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "emailVerified" : {
            "type" : "boolean"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "locale" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "emailVerified", "id", "locale" ],
        "type" : "object"
      },
      "OAuthCodeRequest" : {
        "properties" : {
          "code" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "code" ],
        "type" : "object"
      },
      "OAuthConsentRequest" : {
        "properties" : {
          "code" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "consent" : {
            "type" : "boolean"
          }
        },
        "required" : [ "code", "consent" ],
        "type" : "object"
      },
      "Pong" : {
        "properties" : {
          "status" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Problem" : {
        "description" : "RFC 7807 problem details; errors[] lists invalid fields/rows, empty otherwise",
        "properties" : {
          "detail" : {
            "description" : "Explanation for this occurrence; never contains internals",
            "type" : "string"
          },
          "errors" : {
            "items" : {
              "$ref" : "#/components/schemas/ProblemError"
            },
            "type" : "array"
          },
          "instance" : {
            "description" : "Request path",
            "type" : "string"
          },
          "status" : {
            "description" : "HTTP status code",
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "description" : "Short summary, stable per type",
            "type" : "string"
          },
          "type" : {
            "description" : "URN identifying the problem class, e.g. urn:e9x:problem:validation-failed",
            "type" : "string"
          }
        }
      },
      "ProblemError" : {
        "properties" : {
          "code" : {
            "description" : "Machine-readable constraint code, e.g. NotBlank",
            "type" : "string"
          },
          "field" : {
            "description" : "Path of the offending value in the request, e.g. rows[1].sku",
            "type" : "string"
          },
          "message" : {
            "description" : "Human-readable message",
            "type" : "string"
          },
          "row" : {
            "description" : "Zero-based index of the offending list element, null when not row-specific",
            "format" : "int32",
            "type" : "integer"
          }
        }
      },
      "RefreshRequest" : {
        "properties" : {
          "refreshToken" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "refreshToken" ],
        "type" : "object"
      },
      "RegisterRequest" : {
        "properties" : {
          "consent" : {
            "type" : "boolean"
          },
          "displayName" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "locale" : {
            "enum" : [ "vi", "en" ],
            "maxLength" : 5,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "consent", "displayName", "email", "password" ],
        "type" : "object"
      },
      "RegisterResponse" : {
        "properties" : {
          "status" : {
            "example" : "pending_verification",
            "type" : "string"
          }
        },
        "required" : [ "status" ],
        "type" : "object"
      },
      "ResetConfirmRequest" : {
        "properties" : {
          "newPassword" : {
            "minLength" : 1,
            "type" : "string"
          },
          "token" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "newPassword", "token" ],
        "type" : "object"
      },
      "TokenPair" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "description" : "access token lifetime in seconds",
            "format" : "int64",
            "type" : "integer"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "tokenType" : {
            "example" : "Bearer",
            "type" : "string"
          }
        },
        "required" : [ "accessToken", "expiresIn", "refreshToken", "tokenType" ],
        "type" : "object"
      },
      "TokenRequest" : {
        "properties" : {
          "token" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "token" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/auth/config" : {
      "get" : {
        "operationId" : "config",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthConfig"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Error (RFC 7807 problem details)"
          }
        },
